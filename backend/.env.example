# Copy this file to .env and set your Alpaca credentials before starting the backend
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Optional: if your frontend needs a specific backend URL
# API_BASE_URL=http://127.0.0.1:8000

# Optional: Twilio SMS delivery for intraday RSI alerts
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15551234567

# Optional: local Ollama for natural-language Backtest Lab queries
# Install Ollama, run `ollama pull qwen3:4b`, then start Ollama.
# AI_API_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3:4b
